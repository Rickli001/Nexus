# Copy to .env and fill in. Never commit the real .env.

# Access key the app must present (pick any strong password)
JARVIS_API_KEY=change-me-sir

# "paid" (OpenAI) or "free" (Gemini + Pollinations + edge-tts)
JARVIS_PROVIDER=free

# Free mode
GEMINI_API_KEY=

# Paid mode
OPENAI_API_KEY=

# Code Mode with Claude (optional — falls back to the free chat model without it)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-fable-5

# YouTube
YT_PRIVACY=private
POST_INTERVAL_HOURS=2
